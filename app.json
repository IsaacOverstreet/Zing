{
  "expo": {
    "name": "Zing",
    "slug": "zing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "zing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-logo.png",
      "bundleIdentifier": "com.isaacoverstreet.zing"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.isaacoverstreet.zing"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F5",
          "image": "./assets/images/introLogo.png",
          "resizeMode": "contain",
          "imageWidth": 150
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
