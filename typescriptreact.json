{
  "React Native NativeWind Component": {
    "prefix": "rnc",
    "body": [
      "import { View, Text } from 'react-native';",
      "",
      "export default function ${1:ComponentName}() {",
      "  return (",
      "    <View className=\"flex-1\">",
      "      <Text>${2:content}</Text>",
      "    </View>",
      "  );",
      "}"
    ],
    "description": "React Native component with NativeWind"
  },

  "React Native Screen": {
    "prefix": "rns",
    "body": [
      "import { View, Text } from 'react-native';",
      "import ScreenWrapper from '@/components/ScreenWrapper';",
      "",
      "export default function ${1:ScreenName}() {",
      "  return (",
      "    <ScreenWrapper>",
      "      <Text>${2:content}</Text>",
      "    </ScreenWrapper>",
      "  );",
      "}"
    ],
    "description": "React Native screen with ScreenWrapper"
  }
}
